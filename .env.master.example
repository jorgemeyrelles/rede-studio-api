# ============================================================
#  Rede Studio API — Master (AWS) environment variables TEMPLATE
#  Copy to .env.master and fill in the values.
#  DO NOT commit .env.master — secrets go to AWS Secrets Manager.
# ============================================================

# -- Application --
QUARKUS_PROFILE=master

# -- MongoDB Atlas --
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=rede_studio_prod

# -- JWT --
# Content provided via AWS Secrets Manager secret or mounted volume
JWT_ISSUER=https://api.redestudio.com.br
JWT_EXPIRATION_SECONDS=3600
JWT_PRIVATE_KEY_LOCATION=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_LOCATION=/run/secrets/jwt_public_key

# -- CORS --
CORS_ORIGINS=https://redestudio.com.br

# -- ECS / Container --
PORT=8080
