# =============================================================
#  .env.master.example — variáveis de ambiente para produção (AWS)
#
#  NÃO commite o arquivo .env.master com valores reais.
#  Use AWS Secrets Manager para injetar secrets no ECS Task.
#  Este arquivo serve apenas como documentação das env vars.
# =============================================================

# --- Quarkus ---
QUARKUS_PROFILE=master

# --- MongoDB (EC2 na VPC privada) ---
MONGODB_URI=mongodb://10.0.10.x:27017
MONGODB_DATABASE=rede_studio_prod

# --- JWT ---
JWT_ISSUER=https://api.seudominio.com
JWT_EXPIRATION_SECONDS=86400

# Conteúdo dos arquivos PEM codificado em base64 (sem quebras de linha).
# Gere com: base64 -w 0 secrets/privateKey.pem
# Armazene no AWS Secrets Manager e injete via valueFrom no ECS Task Definition.
JWT_PRIVATE_KEY_B64=<base64_do_privateKey.pem>
JWT_PUBLIC_KEY_B64=<base64_do_publicKey.pem>

# --- CORS ---
CORS_ORIGINS=https://app.seudominio.com

# --- Admin inicial (provisionado no StartupRunner) ---
ADMIN_EMAIL=admin@seudominio.com
ADMIN_USERNAME=adminprod
ADMIN_PASSWORD=<senha_forte_minimo_12_chars>
