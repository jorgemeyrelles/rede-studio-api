#!/bin/bash
#
# cloud-init-rabbitmq.sh — provisionamento da VM rede-studio-rabbitmq
#
# Executado UMA UNICA VEZ no primeiro boot.
# Logs: /var/log/rede-studio-rabbitmq-bootstrap.log
#
set -euxo pipefail

exec > >(tee /var/log/rede-studio-rabbitmq-bootstrap.log) 2>&1

echo "===== [0/4] Firewall local (iptables) ====="
# Imagens Ubuntu da Oracle vem com iptables restrito por padrao (so libera
# SSH) mesmo com a Security List da VCN ja liberando 5672 -- sem isso a
# instancia api nao alcanca o RabbitMQ mesmo com tudo certo na VCN.
iptables -I INPUT -p tcp --dport 5672 -j ACCEPT
netfilter-persistent save 2>/dev/null || true

echo "===== [1/4] Atualizacao do sistema ====="
apt-get update -y
apt-get upgrade -y
apt-get install -y curl jq docker.io docker-compose-v2 python3-pip

systemctl enable --now docker

echo "===== [2/4] Instalar OCI CLI (auth via instance principal) ====="
pip3 install --break-system-packages --ignore-installed oci-cli

echo "===== [3/4] Buscar credenciais do OCI Vault ====="
mkdir -p /opt/rede-studio-rabbitmq
oci secrets secret-bundle get \
  --secret-id "${secret_id}" \
  --region "${region}" \
  --auth instance_principal \
  --query 'data."secret-bundle-content".content' --raw-output \
  | base64 -d > /opt/rede-studio-rabbitmq/app.json

RABBITMQ_USER=$(jq -r '.RABBITMQ_USERNAME' /opt/rede-studio-rabbitmq/app.json)
RABBITMQ_PASS=$(jq -r '.RABBITMQ_PASSWORD' /opt/rede-studio-rabbitmq/app.json)
rm -f /opt/rede-studio-rabbitmq/app.json

echo "===== [4/4] Subir RabbitMQ via Docker Compose ====="
cat >/opt/rede-studio-rabbitmq/docker-compose.yml <<EOF
services:
  rabbitmq:
    image: rabbitmq:3.13-management-alpine
    container_name: rede-studio-rabbitmq
    restart: unless-stopped
    environment:
      RABBITMQ_DEFAULT_USER: $RABBITMQ_USER
      RABBITMQ_DEFAULT_PASS: $RABBITMQ_PASS
    ports:
      # 5672 aberto pra VCN (fechado pra internet na security list) --
      # e onde a instancia api se conecta. 15672 (management UI) so em
      # loopback, acesso via tunel SSH pelo Bastion se precisar depurar.
      - "0.0.0.0:5672:5672"
      - "127.0.0.1:15672:15672"
    volumes:
      - rabbitmq_data:/var/lib/rabbitmq

volumes:
  rabbitmq_data:
EOF

cat >/etc/systemd/system/rede-studio-rabbitmq.service <<'EOF'
[Unit]
Description=Rede Studio — RabbitMQ (Docker Compose)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/rede-studio-rabbitmq
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now rede-studio-rabbitmq

echo "===== BOOTSTRAP RABBITMQ CONCLUIDO ====="
